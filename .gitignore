fetch_log.txt
__pycache__/

# Ignore stray local CSVs anywhere, but keep the checked-in ticker list and
# the daily-refreshed output CSVs under data/ (committed by the workflow).
*.csv
!data/weekly_reutin/*.csv
!data/tableau/*.csv

# ~120MB (12y OHLC for ~500 tickers) — over GitHub's 100MB push limit and
# would bloat repo history if committed daily. Shipped as a workflow artifact
# instead (see .github/workflows/daily-fetch.yml).
data/weekly_reutin/sp500_ohlc.csv
